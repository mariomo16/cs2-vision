{
  "manifest_version": 3,
  "name": "CS2 Vision",
  "description": "View CSStats, FACEIT and Leetify data, plus Steam account information.",
  "version": "1.0.0",
  "icons": {
    "16": "assets/icons/icon512.png",
    "48": "assets/icons/icon512.png",
    "128": "assets/icons/icon512.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://csstats.gg/*",
    "https://cs2-lens-proxy.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/id/*",
        "https://steamcommunity.com/profiles/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*.woff2",
        "assets/premier/*.svg",
        "assets/faceit/*.svg",
        "assets/leetify/*.png",
        "assets/ui/clipboard-document.svg",
        "assets/ui/check.svg",
        "assets/ui/exclamation-triangle.svg"
      ],
      "matches": ["https://steamcommunity.com/*"]
    }
  ]
}
